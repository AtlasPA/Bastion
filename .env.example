# Copy to .env and fill in. Never commit .env.
# Postgres connection string. Local dev: run `npx prisma dev -d --name bastion` and use
# the printed postgres:// URL (default port 51214). Production: Neon connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10"

# Local-only: shadow DB for `prisma migrate dev` (second server prisma dev runs)
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Vercel Blob read/write token (auto-populated in .env.local by `vercel env pull`)
BLOB_READ_WRITE_TOKEN=""

# SendGrid for login + order emails; unset locally = printed to console
SENDGRID_API_KEY=""
EMAIL_FROM="Bastion GameVault <login@bastiongamevault.com>"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SITE_URL="http://localhost:3000"
STRIPE_TAX_ENABLED=""

# Shippo shipping labels (optional until connected)
SHIPPO_API_TOKEN=""
SHIP_FROM_NAME="Bastion GameVault"
SHIP_FROM_STREET1=""
SHIP_FROM_STREET2=""
SHIP_FROM_CITY=""
SHIP_FROM_STATE=""
SHIP_FROM_ZIP=""
SHIP_FROM_PHONE=""
SHIP_FROM_EMAIL=""
